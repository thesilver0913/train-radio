{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrainRadio",
  "version": "4.0.0",
  "identifier": "local.trainradio.desktop",
  "build": { "frontendDist": "../../client" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "列車無線",
        "width": 380,
        "height": 560,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
